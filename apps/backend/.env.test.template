# Variables lues par medusaIntegrationTestRunner (@medusajs/test-utils).
# Copier vers `.env.test` (ignoré par git) et renseigner les valeurs — les mêmes
# que celles de DATABASE_URL dans `.env`.
#
# Le runner IGNORE DATABASE_URL : il reconstruit son URL de connexion depuis ces
# quatre variables, puis crée et détruit une base Postgres jetable par fichier de
# test. L'utilisateur Postgres doit donc avoir le droit de créer des bases
# (`rolcreatedb`).

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
